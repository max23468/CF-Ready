{
  "name": "cf-ready",
  "version": "2.5.5",
  "private": true,
  "packageManager": "npm@12.2.1",
  "packageExtensions": {
    "graphql-request@6.1.0": {
      "peerDependencies": {
        "graphql": "14 - 17"
      }
    },
    "graphql-ws@5.16.2": {
      "peerDependencies": {
        "graphql": ">=0.11 <=17"
      }
    },
    "@shopify/shopify-app-react-router@3.0.2": {
      "peerDependencies": {
        "react-router": "8.4.0"
      }
    }
  },
  "scripts": {
    "postinstall": "node scripts/patch-stryker-vitest.mjs",
    "build": "react-router build --mode dev && node scripts/check-client-bundle.mjs",
    "build:prod": "react-router build --mode prod && node scripts/check-client-bundle.mjs",
    "dev": "shopify app dev",
    "preview": "npm run build && vite preview --mode dev",
    "typegen": "cf workers types && react-router typegen --mode dev",
    "typecheck": "npm run typegen && tsc --noEmit",
    "lint": "oxlint .",
    "quality:knip": "npm run typegen && knip",
    "quality:workflows": "node scripts/check-workflows.mjs",
    "format": "oxfmt --write app benchmarks extensions scripts workers tests cloudflare.config.ts react-router.config.ts vite.config.ts vitest.config.ts vitest.browser.config.ts",
    "format:check": "oxfmt --check app benchmarks extensions scripts workers tests cloudflare.config.ts react-router.config.ts vite.config.ts vitest.config.ts vitest.browser.config.ts",
    "docs:check": "node --test scripts/check-docs.node-test.mjs && node scripts/check-docs.mjs",
    "audit:security": "node --test scripts/security-audit.node-test.mjs && npm run audit:security-scan",
    "audit:security-scan": "node scripts/security-audit.mjs",
    "preflight:dev": "node scripts/preflight-dev.mjs",
    "readback:dev": "node scripts/preflight-dev.mjs --readback-only",
    "test:preflight": "node --test scripts/preflight-dev.node-test.mjs scripts/preflight-prod.node-test.mjs scripts/shopify-info-safe.node-test.mjs scripts/verify-function-schema.node-test.mjs",
    "test:operations": "node --test scripts/backup-crypto.node-test.mjs scripts/check-client-bundle.node-test.mjs scripts/ci-lane.node-test.mjs scripts/ci-policy-check.node-test.mjs scripts/controlled-launch-report.node-test.mjs scripts/coverage-report.node-test.mjs scripts/credential-expiry.node-test.mjs scripts/deploy-receipt.node-test.mjs scripts/github-gates.node-test.mjs scripts/migration-policy.node-test.mjs scripts/operational-entrypoints.node-test.mjs scripts/performance-report.node-test.mjs scripts/provider-readback.node-test.mjs scripts/publish.node-test.mjs scripts/reconcile-develop.node-test.mjs scripts/telegram-owner-control.node-test.mjs scripts/verify-reconciliation-ruleset.node-test.mjs scripts/version-policy.node-test.mjs",
    "publish:development": "node scripts/publish.mjs --target development",
    "publish:production": "node scripts/publish.mjs --target production",
    "promote:production": "node scripts/publish.mjs --promote",
    "verify:change": "node scripts/publish.mjs --verify-only",
    "report:launch": "node scripts/controlled-launch-report.mjs",
    "report:performance": "node scripts/performance-report.mjs",
    "owner-control:telegram": "node scripts/telegram-owner-control.mjs",
    "benchmark:performance": "vitest bench benchmarks/reconcile.bench.ts --run",
    "benchmark:worker-cpu": "vitest bench benchmarks/webhook.bench.ts --run",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "test:ui": "vitest run --config vitest.browser.config.ts",
    "test": "vitest run",
    "test:changed": "vitest run --passWithNoTests --changed",
    "test:migrations": "node --test scripts/migration-policy.node-test.mjs && vitest run tests/migrations.test.ts",
    "test:function": "npm test --workspace cf-ready-validation -- --run",
    "coverage:app": "vitest run --testTimeout=30000 --coverage --coverage.reporter=json --coverage.reportsDirectory=.coverage/app",
    "coverage:ui-chromium": "vitest run --config vitest.browser.config.ts --testTimeout=45000 --project 'merchant-chromium*' --coverage --coverage.reporter=json --coverage.reportsDirectory=.coverage/ui-chromium",
    "coverage:ui-webkit": "vitest run --config vitest.browser.config.ts --testTimeout=45000 --project 'merchant-webkit*' --coverage --coverage.reporter=json --coverage.reportsDirectory=.coverage/ui-webkit",
    "coverage:function": "npm test --workspace cf-ready-validation -- --run tests/validation.test.ts --coverage --coverage.reporter=json --coverage.reportsDirectory=../../.coverage/function",
    "coverage:operations": "GITHUB_ACTIONS=true c8 --all --include 'app/routes.ts' --include 'scripts/**/*.mjs' --include 'site/**/*.js' --exclude 'scripts/*.node-test.mjs' --reporter=json --reports-dir=.coverage/operations node --test scripts/*.node-test.mjs",
    "coverage:collect": "node scripts/coverage-collect.mjs",
    "coverage:check": "npm run coverage:collect && node scripts/coverage-report.mjs",
    "coverage:check-operations": "node scripts/coverage-collect.mjs --operations-only && node scripts/coverage-report.mjs --operations-only",
    "mutation:critical": "node scripts/run-critical-mutation.mjs",
    "build:function": "npm run build --workspace cf-ready-validation",
    "verify:function-schema": "node scripts/verify-function-schema.mjs",
    "doctor": "react-doctor --scope full --blocking warning .",
    "db:migrate:local": "node scripts/d1-local-migrate.mjs",
    "site:dev": "vite site --config config/vite.site.ts",
    "check:docs": "npm run docs:check && git diff --check",
    "check:standard": "npm run docs:check && npm run lint && npm run format:check && npm run typecheck && npm run quality:knip && npm run quality:workflows && npm test && npm run test:ui && npm run test:function && npm run build && npm run build:function && cf deploy --prebuilt --mode dev --dry-run",
    "check:ci-standard": "npm run docs:check && npm run lint && npm run format:check && npm run typecheck && npm run build && npm run build:function && cf deploy --prebuilt --mode dev --dry-run",
    "check:ci-full": "npm run docs:check && npm run audit:security-scan && npm run lint && npm run format:check && npm run typecheck && npm run doctor && npm run build && npm run build:function && cf deploy --prebuilt --mode dev --dry-run",
    "check:ci-metadata": "npm run check:docs",
    "check:local": "npm run docs:check && npm run lint && npm run format:check && npm run typecheck && npm run quality:knip && npm run quality:workflows",
    "check:ci-operations": "npm run docs:check && npm run audit:security-scan && npm run lint && npm run format:check",
    "check": "npm run docs:check && npm run audit:security && npm run lint && npm run format:check && npm run typecheck && npm run quality:knip && npm run quality:workflows && npm run test:preflight && npm run test:operations && npm test && npm run test:ui && npm run test:function && npm run doctor && npm run build && npm run build:function && cf deploy --prebuilt --mode dev --dry-run",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "config:use": "shopify app config use",
    "shopify:info": "node scripts/shopify-info-safe.mjs",
    "env": "shopify app env",
    "shopify": "shopify",
    "vite": "vite",
    "preflight:prod": "node scripts/preflight-prod.mjs"
  },
  "type": "module",
  "engines": {
    "node": ">=26.12.0 <27"
  },
  "dependencies": {
    "@shopify/shopify-api": "15.0.1",
    "@shopify/shopify-app-react-router": "3.0.2",
    "@shopify/shopify-app-session-storage": "7.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.1",
    "@cloudflare/vitest-plugin": "1.4.4",
    "@graphql-codegen/cli": "7.4.6",
    "@playwright/test": "1.64.1",
    "@react-router/dev": "8.4.0",
    "@shopify/cli": "4.9.4",
    "@shopify/polaris-types": "2.0.0-rc.3",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-istanbul": "5.0.5",
    "c8": "12.0.0",
    "cf": "1.0.0-beta.18",
    "esbuild": "0.28.2",
    "graphql": "17.0.2",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "knip": "6.42.0",
    "mdast-util-from-markdown": "2.1.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "react-doctor": "0.9.18",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  },
  "workspaces": [
    "extensions/*"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "allowScripts": {
    "core-js": false,
    "esbuild": true,
    "fsevents@2.3.2": false,
    "fsevents@2.3.3": true,
    "workerd": true
  },
  "overrides": {
    "@graphql-tools/utils": "12.1.0",
    "graphql-config": "5.1.8",
    "lodash": "4.18.1",
    "qs": "6.16.1",
    "sharp": "0.35.5",
    "undici": "8.12.2"
  },
  "author": "Matteo"
}
