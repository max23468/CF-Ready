{
  "name": "cf-ready",
  "version": "1.0.4",
  "private": true,
  "packageManager": "npm@12.0.2",
  "packageExtensions": {
    "@shopify/shopify-app-react-router@2.0.0": {
      "peerDependencies": {
        "react-router": "^7.18.2 || ^8.3.0"
      }
    },
    "graphql-config@5.1.6": {
      "peerDependencies": {
        "graphql": "^14.0.0 || ^15.0.0 || ^16.0.0 || ^17.0.0"
      }
    },
    "graphql-request@6.1.0": {
      "peerDependencies": {
        "graphql": "14 - 17"
      }
    },
    "graphql-ws@5.16.2": {
      "peerDependencies": {
        "graphql": ">=0.11 <=17"
      }
    }
  },
  "scripts": {
    "build": "react-router build && node scripts/check-client-bundle.mjs",
    "dev": "shopify app dev",
    "preview": "npm run build && vite preview",
    "typegen": "mkdir -p .wrangler/types && wrangler types .wrangler/types/worker-configuration.d.ts && react-router typegen",
    "typecheck": "npm run typegen && tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write app extensions scripts workers tests react-router.config.ts vite.config.ts vitest.config.ts",
    "format:check": "oxfmt --check app extensions scripts workers tests react-router.config.ts vite.config.ts vitest.config.ts",
    "docs:check": "node --test scripts/check-docs.node-test.mjs && node scripts/check-docs.mjs",
    "audit:security": "node --test scripts/security-audit.node-test.mjs && node scripts/security-audit.mjs",
    "preflight:dev": "node scripts/preflight-dev.mjs",
    "readback:dev": "node scripts/preflight-dev.mjs --readback-only",
    "test:preflight": "node --test scripts/preflight-dev.node-test.mjs scripts/preflight-prod.node-test.mjs scripts/shopify-info-safe.node-test.mjs scripts/verify-function-schema.node-test.mjs",
    "test:operations": "node --test scripts/backup-crypto.node-test.mjs scripts/capacity-check.node-test.mjs scripts/check-client-bundle.node-test.mjs scripts/ci-lane.node-test.mjs scripts/codex-review-gate.test.mjs scripts/controlled-launch-report.node-test.mjs scripts/credential-expiry.node-test.mjs scripts/deploy-receipt.node-test.mjs scripts/github-gates.node-test.mjs scripts/reconcile-develop.node-test.mjs",
    "capacity:dev": "node scripts/capacity-check.mjs",
    "report:launch": "node scripts/controlled-launch-report.mjs",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "test": "vitest run",
    "test:function": "npm test --workspace cf-ready-validation -- --run",
    "build:function": "npm run build --workspace cf-ready-validation",
    "verify:function-schema": "node scripts/verify-function-schema.mjs",
    "doctor": "react-doctor --scope full --blocking warning .",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "site:dev": "rm -f .wrangler/deploy/config.json && wrangler pages dev site",
    "check:docs": "npm run docs:check && git diff --check",
    "check:standard": "npm run docs:check && npm run lint && npm run format:check && npm run typecheck && npm test && npm run test:function && npm run build && npm run build:function && wrangler deploy --dry-run",
    "check": "npm run docs:check && npm run audit:security && npm run lint && npm run format:check && npm run typecheck && npm run test:preflight && npm run test:operations && npm test && npm run test:function && npm run doctor && npm run build && npm run build:function && wrangler deploy --dry-run",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "config:use": "shopify app config use",
    "shopify:info": "node scripts/shopify-info-safe.mjs",
    "env": "shopify app env",
    "shopify": "shopify",
    "vite": "vite",
    "preflight:prod": "node scripts/preflight-prod.mjs"
  },
  "type": "module",
  "engines": {
    "node": ">=26.7.0 <27"
  },
  "dependencies": {
    "@shopify/shopify-api": "14.0.0",
    "@shopify/shopify-app-react-router": "2.0.0",
    "@shopify/shopify-app-session-storage": "6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.0",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@graphql-codegen/cli": "7.3.1",
    "@playwright/test": "1.62.1",
    "@react-router/dev": "8.3.0",
    "@shopify/polaris-types": "1.0.7",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "graphql": "17.0.2",
    "mdast-util-from-markdown": "2.0.3",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "react-doctor": "0.9.12",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.126.0"
  },
  "workspaces": [
    "extensions/*"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "allowScripts": {
    "core-js": false,
    "esbuild@0.28.1": true,
    "fsevents@2.3.2": false,
    "fsevents@2.3.3": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20260825.1": true
  },
  "overrides": {
    "graphql-config": "5.1.6",
    "lodash": "4.18.1",
    "undici": "7.29.0"
  },
  "author": "Matteo"
}
