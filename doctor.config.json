{
  "$schema": "https://react.doctor/schema/config.json",
  "blocking": "warning",
  "supplyChain": {
    "enabled": false
  },
  "ignore": {
    "files": ["site/**"],
    "overrides": [
      {
        "files": ["app/routes/app.tsx"],
        "rules": ["react-doctor/only-export-components"]
      },
      {
        "files": ["app/root.tsx"],
        "rules": [
          "react-doctor/no-undeferred-third-party",
          "react-doctor/rendering-script-defer-async"
        ]
      }
    ]
  }
}
