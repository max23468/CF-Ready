/*
  Content-Security-Policy: default-src 'none'; style-src 'self'; img-src 'self'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), interest-cohort=()

# Privacy e Termini riportano il nome della persona fisica titolare. Restano
# pubblici e raggiungibili — Shopify li richiede — ma fuori dai motori di
# ricerca. Serve noindex, non un Disallow in robots.txt: una pagina esclusa dal
# crawl può comunque finire in SERP, e il crawler non leggerebbe mai il noindex.
/privacy*
  X-Robots-Tag: noindex

/terms*
  X-Robots-Tag: noindex

/en/privacy*
  X-Robots-Tag: noindex

/en/terms*
  X-Robots-Tag: noindex
